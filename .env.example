# Public values provided by the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Application URL used for safe authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional private album abuse/cost limits. Storage hard-caps files at 4 MB.
SOLES_MAX_PHOTO_BYTES=4194304
SOLES_MAX_PHOTO_WIDTH=12000
SOLES_MAX_PHOTO_HEIGHT=12000
SOLES_MAX_PHOTOS_PER_TRIP=500
SOLES_PHOTO_UPLOADS_PER_MINUTE=10
SOLES_PHOTO_PAGE_SIZE=12
